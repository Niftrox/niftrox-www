---
// Self-hosted fonts (no Google CDN — perf + EU/GDPR friendly)
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/inter/900.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';

const title = 'ChangeOps — find the change that broke production';
const description =
  "ChangeOps turns Azure's scattered change history into a ranked, evidence-backed shortlist — so on-call goes from 40 minutes of portal-hopping to under five. Azure-first incident investigation. Launching 2027.";

const site = Astro.site ?? new URL('https://niftrox.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#070b14" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Niftrox · ChangeOps" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <canvas id="bgfx" aria-hidden="true"></canvas>
    <slot />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
      }
    </script>

    <script>
      // Site-wide scroll-reveal. Reduced-motion: do nothing (content stays visible).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        const selector = '.uc, .pipe, .deliver, .ecard, .rcard, .flow-head, .eh, .rh, .foot-in';
        const els = Array.from(document.querySelectorAll<HTMLElement>(selector));
        for (const el of els) {
          el.style.opacity = '0';
          el.style.transform = 'translateY(26px)';
          el.style.transition = 'opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1)';
        }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            const sibs = el.parentElement
              ? Array.from(el.parentElement.children).filter(
                  (c) => (c as HTMLElement).style && (c as HTMLElement).style.opacity === '0'
                )
              : [];
            const idx = Math.max(0, sibs.indexOf(el));
            el.style.transitionDelay = idx * 0.08 + 's';
            el.style.opacity = '1';
            el.style.transform = 'none';
            io.unobserve(el);
          }
        }, { threshold: 0.16 });
        for (const el of els) io.observe(el);
      }
    </script>

    <script>
      // Page-wide ambient correlation network (behind the lower sections).
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const canvas = document.getElementById('bgfx');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        let W = 0, H = 0, t = 0, nodes: { x: number; y: number; vx: number; vy: number; r: number; hue: string; tw: number; ts: number }[] = [];
        const pulses: { x: number; y: number; r: number; max: number }[] = [];
        let raf = 0, running = false, ptimer = 0;

        function resize() {
          const dpr = window.devicePixelRatio || 1;
          W = window.innerWidth; H = window.innerHeight;
          canvas.width = W * dpr; canvas.height = H * dpr;
          canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        function seed() {
          const n = Math.max(30, Math.min(64, Math.round((W * H) / 22000)));
          nodes = Array.from({ length: n }, () => ({
            x: Math.random() * W, y: Math.random() * H,
            vx: (Math.random() - .5) * .16, vy: (Math.random() - .5) * .16,
            r: Math.random() * 1.5 + .7,
            hue: Math.random() > .72 ? '122,162,255' : '94,234,212',
            tw: Math.random() * Math.PI * 2,        // twinkle phase
            ts: 0.6 + Math.random() * 0.9,          // twinkle speed
          }));
        }
        function spawn() { const p = nodes[Math.floor(Math.random() * nodes.length)]; if (p) pulses.push({ x: p.x, y: p.y, r: 8, max: 300 }); }
        function draw() {
          t += 0.016;
          ctx.clearRect(0, 0, W, H);
          for (const p of nodes) { p.x += p.vx; p.y += p.vy; if (p.x < 0 || p.x > W) p.vx *= -1; if (p.y < 0 || p.y > H) p.vy *= -1; }
          for (let k = pulses.length - 1; k >= 0; k--) {
            const pl = pulses[k]; pl.r += 2.2; const a = Math.max(0, 1 - pl.r / pl.max);
            ctx.strokeStyle = `rgba(53,224,200,${a * .3})`; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.arc(pl.x, pl.y, pl.r, 0, Math.PI * 2); ctx.stroke();
            if (pl.r > pl.max) pulses.splice(k, 1);
          }
          for (let i = 0; i < nodes.length; i++) for (let j = i + 1; j < nodes.length; j++) {
            const a = nodes[i], b = nodes[j]; const d = Math.hypot(a.x - b.x, a.y - b.y);
            if (d < 155) {
              let o = (1 - d / 155) * .3;
              for (const pl of pulses) { const band = Math.abs(Math.hypot(a.x - pl.x, a.y - pl.y) - pl.r); if (band < 26) o = Math.min(.7, o + .4 * (1 - band / 26)); }
              ctx.strokeStyle = `rgba(94,234,212,${o})`; ctx.lineWidth = .65;
              ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
            }
          }
          // twinkling stars
          for (const p of nodes) {
            const a = 0.5 + 0.5 * Math.sin(t * p.ts + p.tw);  // 0..1 twinkle
            ctx.fillStyle = `rgba(${p.hue},${0.35 + 0.6 * a})`;
            ctx.beginPath(); ctx.arc(p.x, p.y, p.r + a * 0.6, 0, Math.PI * 2); ctx.fill();
          }
          raf = requestAnimationFrame(draw);
        }
        function start() { if (running || reduce) return; running = true; draw(); ptimer = window.setInterval(spawn, 2400); }
        function stop() { if (!running) return; running = false; cancelAnimationFrame(raf); clearInterval(ptimer); }

        resize(); seed();
        if (reduce) { draw(); cancelAnimationFrame(raf); } else { start(); }
        document.addEventListener('visibilitychange', () => { document.hidden ? stop() : start(); });
        let rt: number; window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { resize(); seed(); }, 200); });
      })();
    </script>
  </body>
</html>
