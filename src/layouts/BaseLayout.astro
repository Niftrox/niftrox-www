---
// Only the weights actually used, latin subset only (English site).
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '../styles/global.css';

const title = 'ChangeOps — find the change that broke production';
const description =
  "ChangeOps turns Azure's scattered change history into a ranked, evidence-backed shortlist — so on-call goes from 40 minutes of portal-hopping to under five. Azure-first incident investigation. Launching 2027.";

const site = Astro.site ?? new URL('https://niftrox.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#070b14" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Niftrox · ChangeOps" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <!-- one unified animated backdrop behind the whole page -->
    <div id="bg" aria-hidden="true">
      <div class="bg-aurora"><span class="a1"></span><span class="a2"></span><span class="a3"></span><span class="a4"></span></div>
      <div class="bg-grid"></div>
      <canvas id="bgfx"></canvas>
      <div id="bg-glow"></div>
      <div class="bg-vignette"></div>
    </div>

    <slot />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
      }
    </script>

    <script>
      // Single ambient correlation-network backdrop for the whole page.
      // Capped DPR + ~30fps + node count scaled to viewport = smooth on mobile.
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const canvas = document.getElementById('bgfx') as HTMLCanvasElement | null;
        const glow = document.getElementById('bg-glow');
        if (!canvas) return;
        const ctx = canvas.getContext('2d')!;
        let W = 0, H = 0, t = 0, lastDraw = 0, raf = 0, running = false, ptimer = 0;
        let nodes: { x: number; y: number; vx: number; vy: number; r: number; hue: string; tw: number; ts: number }[] = [];
        const pulses: { x: number; y: number; r: number; max: number }[] = [];

        function resize() {
          const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          W = window.innerWidth; H = window.innerHeight;
          canvas!.width = Math.round(W * dpr); canvas!.height = Math.round(H * dpr);
          canvas!.style.width = W + 'px'; canvas!.style.height = H + 'px';
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        function seed() {
          const n = Math.max(30, Math.min(60, Math.round(W / 20)));
          nodes = Array.from({ length: n }, () => ({
            x: Math.random() * W, y: Math.random() * H,
            vx: (Math.random() - .5) * .18, vy: (Math.random() - .5) * .18,
            r: Math.random() * 1.5 + .7,
            hue: Math.random() > .72 ? '122,162,255' : '94,234,212',
            tw: Math.random() * Math.PI * 2, ts: 0.6 + Math.random() * 0.9,
          }));
        }
        function spawn() { const p = nodes[Math.floor(Math.random() * nodes.length)]; if (p) pulses.push({ x: p.x, y: p.y, r: 8, max: 300 }); }
        function draw() {
          raf = requestAnimationFrame(draw);
          const now = performance.now();
          if (now - lastDraw < 32) return;       // ~30fps
          lastDraw = now;
          t += 0.03;
          ctx.clearRect(0, 0, W, H);
          for (const p of nodes) { p.x += p.vx; p.y += p.vy; if (p.x < 0 || p.x > W) p.vx *= -1; if (p.y < 0 || p.y > H) p.vy *= -1; }
          for (let k = pulses.length - 1; k >= 0; k--) {
            const pl = pulses[k]; pl.r += 2.2; const a = Math.max(0, 1 - pl.r / pl.max);
            ctx.strokeStyle = `rgba(53,224,200,${a * .26})`; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.arc(pl.x, pl.y, pl.r, 0, Math.PI * 2); ctx.stroke();
            if (pl.r > pl.max) pulses.splice(k, 1);
          }
          for (let i = 0; i < nodes.length; i++) for (let j = i + 1; j < nodes.length; j++) {
            const a = nodes[i], b = nodes[j]; const dx = a.x - b.x, dy = a.y - b.y; const d = Math.hypot(dx, dy);
            if (d < 152) {
              let o = (1 - d / 152) * .26;
              for (const pl of pulses) { const band = Math.abs(Math.hypot(a.x - pl.x, a.y - pl.y) - pl.r); if (band < 26) o = Math.min(.65, o + .4 * (1 - band / 26)); }
              ctx.strokeStyle = `rgba(94,234,212,${o})`; ctx.lineWidth = .65;
              ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
            }
          }
          for (const p of nodes) {
            const a = 0.5 + 0.5 * Math.sin(t * p.ts + p.tw);
            ctx.fillStyle = `rgba(${p.hue},${0.4 + 0.55 * a})`;
            ctx.beginPath(); ctx.arc(p.x, p.y, p.r + a * 0.5, 0, Math.PI * 2); ctx.fill();
          }
        }
        function start() { if (running || reduce || document.hidden) return; running = true; lastDraw = 0; draw(); ptimer = window.setInterval(spawn, 2600); }
        function stop() { if (!running) return; running = false; cancelAnimationFrame(raf); clearInterval(ptimer); }

        resize(); seed();
        if (reduce) { draw(); cancelAnimationFrame(raf); } else { start(); }
        document.addEventListener('visibilitychange', () => { document.hidden ? stop() : start(); });
        let rt: number; window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { resize(); seed(); }, 200); });

        // cursor glow (desktop pointers only; no-op on touch)
        if (glow && window.matchMedia('(pointer: fine)').matches) {
          window.addEventListener('pointermove', (e) => { glow.style.left = e.clientX + 'px'; glow.style.top = e.clientY + 'px'; glow.style.opacity = '1'; }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
