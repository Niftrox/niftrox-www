---
// Use-cases band — translucent layer over the global backdrop.
---

<section class="usecases" aria-label="What ChangeOps is for">
  <h2 class="sr-only">What ChangeOps is for</h2>
  <div class="grid shell">
    <div class="uc">
      <div class="ic" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M13 2 L4 14 h7 l-1 8 9-12 h-7 z" /></svg>
      </div>
      <div>
        <h3>Triage in minutes</h3>
        <p>Find the change behind a live incident — under five minutes, no portal-hopping.</p>
      </div>
    </div>
    <div class="uc">
      <div class="ic" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M21 8 L12 3 L3 8 v8 l9 5 9-5 z" /><path d="M3 8 l9 5 9-5 M12 13 v8" /></svg>
      </div>
      <div>
        <h3>Evidence packs</h3>
        <p>Timestamped, attributed, confidence-labelled — and exportable anywhere.</p>
      </div>
    </div>
    <div class="uc">
      <div class="ic" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M7 3 h10 a2 2 0 0 1 2 2 v14 a2 2 0 0 1 -2 2 H7 a2 2 0 0 1 -2 -2 V5 a2 2 0 0 1 2 -2 z" /><path d="M9 8 h6 M9 12 h6 M9 16 h4" /></svg>
      </div>
      <div>
        <h3>Postmortems &amp; audits</h3>
        <p>Blameless postmortems, compliance audits, and vendor escalations — in one export.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .usecases { position: relative; background: rgba(8,12,22,.5); border-top: 1px solid #1a2336; padding: 36px var(--pad); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .uc { display: flex; gap: 14px; align-items: flex-start; }
  .ic { width: 40px; height: 40px; border-radius: 11px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: rgba(53,224,200,.1); border: 1px solid rgba(53,224,200,.28); transition: transform .25s, box-shadow .25s; }
  .ic svg { width: 20px; height: 20px; stroke: var(--accent); fill: none; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .uc:hover .ic { transform: translateY(-3px) scale(1.05); box-shadow: 0 10px 24px -10px rgba(53,224,200,.5); }
  .uc h3 { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
  .uc p { font-size: 12.5px; color: var(--muted-2); line-height: 1.5; }

  @media (max-width: 767px) { .grid { grid-template-columns: 1fr; gap: 20px; } }
</style>
