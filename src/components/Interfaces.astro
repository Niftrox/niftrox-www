---
// Interfaces fan-out — the one ledger and everyone who reads from it. Later items are dashed.
---

<section class="delivery" aria-label="Who reads the ledger">
  <div class="dh shell">
    <h2>One ledger. Everyone reads the same record.</h2>
  </div>
  <div class="deliver shell">
    <div class="hub">
      <div class="ht">SERVED FROM</div>
      <div class="hbig">The ledger</div>
      <div class="hsub">people · agents · auditors</div>
      <span class="emit" aria-hidden="true"></span>
    </div>

    <div class="spine" aria-hidden="true"></div>
    <div class="vspine" aria-hidden="true"><span class="vp"></span></div>

    <div class="dests">
      <div class="drow"><div class="branch" aria-hidden="true"><span class="p"></span></div>
        <div class="dchip delivered">
          <span aria-hidden="true" class="mk"><svg viewBox="0 0 24 24"><path d="M4 5h16v13H4z"/><path d="M8 10l3 2.5-3 2.5M13 15h4"/></svg></span>
          <span class="txt"><span class="nm">Your AI assistants, over MCP</span><span class="sub">Claude, ChatGPT, GitHub Copilot, Copilot Studio, Azure SRE Agent</span></span>
          <span class="meta">your login <span class="ok">✓</span></span>
        </div></div>
      <div class="drow"><div class="branch" aria-hidden="true"><span class="p" style="animation-delay:.4s"></span></div>
        <div class="dchip delivered" style="animation-delay:.4s">
          <span aria-hidden="true" class="mk"><svg viewBox="0 0 24 24"><path d="M3 5h18v14H3z"/><path d="M3 9h18M7 7h.01M10 7h.01"/></svg></span>
          <span class="txt"><span class="nm">Web app</span><span class="sub">onboarding, connection health, timeline, evidence, admin</span></span>
          <span class="meta">same ids <span class="ok" style="animation-delay:.4s">✓</span></span>
        </div></div>
      <div class="drow"><div class="branch" aria-hidden="true"><span class="p" style="animation-delay:.8s"></span></div>
        <div class="dchip delivered" style="animation-delay:.8s">
          <span aria-hidden="true" class="mk"><svg viewBox="0 0 24 24"><path d="M8 4c-2 0-3 1-3 3v3c0 1-1 2-2 2 1 0 2 1 2 2v3c0 2 1 3 3 3M16 4c2 0 3 1 3 3v3c0 1 1 2 2 2-1 0-2 1-2 2v3c0 2-1 3-3 3"/></svg></span>
          <span class="txt"><span class="nm">REST API and signed webhooks</span><span class="sub">a webhook when a pack, report or export is ready</span></span>
          <span class="meta">signed <span class="ok" style="animation-delay:.8s">✓</span></span>
        </div></div>
      <div class="drow"><div class="branch" aria-hidden="true"><span class="p" style="animation-delay:1.2s"></span></div>
        <div class="dchip delivered" style="animation-delay:1.2s">
          <span aria-hidden="true" class="mk"><svg viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.6.4l3-3a4 4 0 0 0-5.6-5.6l-1.5 1.5"/><path d="M14 10a4 4 0 0 0-5.6-.4l-3 3a4 4 0 0 0 5.6 5.6l1.5-1.5"/></svg></span>
          <span class="txt"><span class="nm">Share links</span><span class="sub">any change, pack or report, scoped to your organisation</span></span>
          <span class="meta">any tool <span class="ok" style="animation-delay:1.2s">✓</span></span>
        </div></div>
      <div class="drow"><div class="branch" aria-hidden="true"><span class="p" style="animation-delay:1.6s"></span></div>
        <div class="dchip delivered" style="animation-delay:1.6s">
          <span aria-hidden="true" class="mk"><svg viewBox="0 0 24 24"><path d="M21 8 L12 3 L3 8 v8 l9 5 9-5 z"/><path d="M3 8 l9 5 9-5 M12 13 v8"/></svg></span>
          <span class="txt"><span class="nm">Evidence packs and the period report</span><span class="sub">sealed; anyone verifies offline, no account needed</span></span>
          <span class="meta">verifiable <span class="ok" style="animation-delay:1.6s">✓</span></span>
        </div></div>
      <div class="drow"><div class="branch" aria-hidden="true"></div>
        <div class="dchip soon">
          <span aria-hidden="true" class="mk"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <span class="txt"><span class="nm">Your SIEM and compliance platform</span><span class="sub">audit events into your log store; packs and reports into Vanta or Drata by your own script</span></span>
          <span class="meta soonl">later</span>
        </div></div>
    </div>
  </div>
</section>

<style>
  .delivery { position: relative; padding: 8px var(--pad) 50px; background: rgba(8,12,22,.5); }
  .dh { text-align: center; margin-bottom: 26px; }
  .dh h2 { font-size: clamp(20px, 2.4vw, 23px); font-weight: 800; letter-spacing: -.02em; line-height: 1.2; text-wrap: balance; }

  .deliver { position: relative; z-index: 1; display: grid; grid-template-columns: auto 38px 1fr; align-items: center; }
  .hub { background: linear-gradient(180deg, rgba(18,24,40,.8), rgba(12,17,30,.85)); border: 1px solid #2a3958; border-radius: 14px; padding: 13px 16px; box-shadow: 0 18px 50px -26px rgba(0,0,0,.9); position: relative; }
  .ht { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; color: var(--accent); }
  .hbig { font-size: 17px; font-weight: 800; margin: 3px 0 2px; }
  .hsub { font-size: 11px; color: var(--muted-2); }
  .emit { position: absolute; right: -6px; top: 50%; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); transform: translateY(-50%); animation: emit 3s ease-in-out infinite; }

  .spine { position: relative; height: 300px; }
  .spine::before { content: ""; position: absolute; left: 50%; top: 8%; height: 84%; width: 2px; background: linear-gradient(180deg, transparent, #2f3e5c, transparent); transform: translateX(-50%); }
  .vspine { display: none; }

  .dests { display: flex; flex-direction: column; gap: 9px; }
  .drow { display: flex; align-items: center; gap: 14px; }
  .branch { position: relative; height: 2px; width: 44px; background: linear-gradient(90deg, #2f3e5c, var(--border)); flex-shrink: 0; }
  .branch .p { position: absolute; top: 50%; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 7px var(--accent); transform: translateY(-50%); animation: branchtravel 3s ease-in infinite; }

  .dchip { display: flex; align-items: center; gap: 11px; background: rgba(16,22,38,.7); border: 1px solid var(--border); border-radius: 11px; padding: 8px 14px; flex: 1; min-width: 0; }
  .dchip .mk { width: 24px; height: 24px; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(53,224,200,.1); border: 1px solid rgba(53,224,200,.28); }
  .dchip .mk svg { width: 14px; height: 14px; stroke: var(--accent); fill: none; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .dchip .txt { display: flex; flex-direction: column; min-width: 0; }
  .dchip .nm { font-size: 13px; font-weight: 600; }
  .dchip .sub { font-size: 10.5px; color: var(--dim); line-height: 1.35; margin-top: 1px; }
  .dchip .meta { font-size: 10px; color: var(--dim); margin-left: auto; font-family: var(--mono); white-space: nowrap; padding-left: 8px; }
  .dchip.delivered { animation: arrive 3s ease-in-out infinite; }
  .dchip .ok { color: var(--accent); opacity: 0; animation: okp 3s ease-in-out infinite; }
  .dchip.soon { border-style: dashed; }
  .dchip.soon .nm { color: var(--muted-2); }
  .dchip.soon .mk { opacity: .65; background: rgba(120,138,170,.08); border-color: #2a3650; }
  .dchip.soon .mk svg { stroke: var(--low); }
  .soonl { color: var(--dim); }

  /* ---------- mobile ---------- */
  @media (max-width: 767px) {
    .deliver { display: flex; flex-direction: column; align-items: center; }
    .hub { text-align: center; width: 100%; max-width: 320px; }
    .emit { display: none; }
    .spine { display: none; }
    .vspine { display: block; height: 24px; width: 2px; position: relative; background: linear-gradient(180deg, #2f3e5c, var(--border)); }
    .vspine .vp { position: absolute; left: 50%; top: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 7px var(--accent); transform: translateX(-50%); animation: vtravel 1.6s linear infinite; }
    .dests { width: 100%; }
    .branch { display: none; }
    .dchip { padding: 9px 11px; }
    .dchip .nm { font-size: 12.5px; overflow-wrap: anywhere; }
    .dchip .meta { display: none; }
    .dchip.soon .meta.soonl { display: block; }
  }

  /* desktop/landscape only: frosted-glass chips + hub */
  @media (min-width: 861px) {
    .dchip { background: rgba(16,22,38,.46); -webkit-backdrop-filter: blur(9px); backdrop-filter: blur(9px); }
    .hub { background: linear-gradient(180deg, rgba(18,24,40,.6), rgba(12,17,30,.66)); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  }
</style>
