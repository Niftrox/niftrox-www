---
// Hero — content layer over the global animated backdrop.
---

<section class="hero" aria-label="ChangeOps — Azure-first incident investigation">
  <div class="fg">
    <nav class="nav" aria-label="Primary">
      <a class="brand" href="/">
        <img class="logo-mark" src="/logo.png" width="30" height="30" alt="" decoding="async" />
        <span class="wordmark">niftrox<span>/</span>changeops</span>
      </a>
      <span class="tag"><span class="blip"></span>LAUNCHING 2027</span>
    </nav>

    <div class="hero-grid">
      <div class="copy">
        <p class="eyebrow">Azure-first incident investigation</p>
        <h1>Find the change<br />that broke production. <span class="muted">Fast.</span></h1>
        <p class="sub">
          ChangeOps turns Azure's scattered change history into a ranked,
          evidence-backed shortlist — so on-call goes from 40 minutes of
          portal-hopping to under five.
        </p>
        <div class="traj">
          <span class="t on">Azure today</span>
          <span class="t">AWS &amp; GCP next</span>
          <span class="t">AI summaries later</span>
        </div>
      </div>

      <div class="scbox">
        <span class="concept-tag">// concept</span>
        <div class="scorecard">
          <div class="sc-head"><span>RANKED EVIDENCE</span><span>3 suspects · 14:00–14:10Z</span></div>
          <div class="sc1">
            <div class="sc1-top">
              <span class="rk">#1</span>
              <span class="sc-score">92</span>
              <span class="badge-high">HIGH</span>
              <span class="mono-dim">deterministic</span>
            </div>
            <div class="sc1-title">Microsoft.Web/sites · app config updated</div>
            <div class="sc1-meta"><b>deploy-sp@prod</b> · 4m before alert · Activity Log ↔ Resource Graph</div>
          </div>
          <div class="scrow">
            <span class="rk">#2</span>
            <div class="scrow-mid">
              <div class="scrow-title">AKS · node pool image upgrade</div>
              <div class="scrow-src">AKS audit log · heuristic</div>
            </div>
            <span class="badge-med">MED</span><span class="scn med">71</span>
          </div>
          <div class="scrow">
            <span class="rk">#3</span>
            <div class="scrow-mid">
              <div class="scrow-title">Network · NSG rule changed</div>
              <div class="scrow-src">Activity Log</div>
            </div>
            <span class="badge-low">LOW</span><span class="scn low">54</span>
          </div>
        </div>
      </div>
    </div>

    <div class="scrollcue" aria-hidden="true"><span class="mouse"></span>HOW IT WORKS</div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 624px; display: flex; flex-direction: column; color: var(--text); }
  .fg {
    position: relative; flex: 1;
    display: flex; flex-direction: column;
    width: 100%; max-width: var(--maxw); margin: 0 auto;
    padding: 22px var(--pad) 40px;
  }
  .nav { display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 800; font-size: 15px; letter-spacing: -.01em; color: var(--text); }
  .logo-mark { width: 30px; height: 30px; border-radius: 7px; border: 1px solid var(--border-2); background: #04060c; object-fit: cover; flex-shrink: 0; }
  .wordmark span { color: var(--accent); }
  .tag { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; color: var(--dim); border: 1px solid var(--border-2); padding: 5px 11px; border-radius: 999px; display: inline-flex; align-items: center; gap: 7px; background: rgba(8,12,22,.5); }
  .tag .blip { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); animation: blip 2s ease-in-out infinite; }

  .hero-grid { flex: 1; display: grid; grid-template-columns: 1fr 1.02fr; gap: 32px; align-items: center; padding: 18px 0; }
  .hero-grid > * { min-width: 0; }
  h1 { font-size: clamp(34px, 5vw, 46px); line-height: 1.03; font-weight: 800; letter-spacing: -.03em; margin: 15px 0 14px; }
  h1 .muted { color: #5e6b82; }
  .sub { color: var(--muted); font-size: clamp(14px, 1.4vw, 15px); max-width: 460px; }

  .traj { display: flex; gap: 8px; margin-top: 20px; flex-wrap: wrap; }
  .traj .t { font-family: var(--mono); font-size: 11px; color: var(--dimmer); border: 1px solid #222c40; padding: 5px 11px; border-radius: 999px; display: flex; align-items: center; gap: 7px; background: rgba(8,12,22,.5); }
  .traj .t::before { content: ""; width: 6px; height: 6px; border-radius: 50%; border: 1.5px solid #44516b; }
  .traj .t.on { color: #cdeee7; border-color: rgba(53,224,200,.4); }
  .traj .t.on::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 7px var(--accent); }

  /* scorecard — a clean opaque layer (no backdrop-filter, for mobile perf) */
  .scbox { position: relative; }
  .scorecard {
    background: linear-gradient(180deg, rgba(17,23,38,.95), rgba(11,16,28,.97));
    border: 1px solid var(--border-2); border-radius: 16px; padding: 15px 16px;
    box-shadow: 0 24px 60px -28px rgba(0,0,0,.9); animation: floaty 6s ease-in-out infinite;
  }
  .sc-head { display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 10px; letter-spacing: .1em; color: var(--dim); padding-bottom: 10px; border-bottom: 1px solid #1e2740; }
  .sc1 { padding: 11px 0; border-bottom: 1px solid #1e2740; }
  .sc1-top { display: flex; align-items: center; gap: 9px; }
  .rk { font-family: var(--mono); font-size: 11px; color: var(--dim); font-weight: 600; }
  .sc-score { font-size: 26px; font-weight: 800; color: var(--accent); line-height: 1; }
  .badge-high { background: rgba(53,224,200,.14); color: var(--accent); border: 1px solid rgba(53,224,200,.4); padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: 700; animation: pulse 2.6s ease-in-out infinite; }
  .mono-dim { font-family: var(--mono); font-size: 10px; color: var(--dimmer); margin-left: auto; }
  .sc1-title { font-size: 14px; font-weight: 600; margin-top: 8px; }
  .sc1-meta { font-family: var(--mono); font-size: 10.5px; color: var(--dim); margin-top: 5px; }
  .sc1-meta b { color: #aeb8ca; font-weight: 600; }
  .scrow { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid #1e2740; }
  .scrow:last-child { border-bottom: none; }
  .scrow-mid { flex: 1; min-width: 0; }
  .scrow-title { font-size: 12.5px; font-weight: 600; }
  .scrow-src { font-family: var(--mono); font-size: 10px; color: var(--dim); margin-top: 2px; }
  .badge-med { background: rgba(245,177,76,.13); color: var(--med); border: 1px solid rgba(245,177,76,.35); padding: 2px 7px; border-radius: 999px; font-size: 9.5px; font-weight: 700; }
  .badge-low { background: rgba(120,138,170,.12); color: var(--low); border: 1px solid rgba(120,138,170,.3); padding: 2px 7px; border-radius: 999px; font-size: 9.5px; font-weight: 700; }
  .scn { font-family: var(--mono); font-size: 15px; font-weight: 700; width: 24px; text-align: right; }
  .scn.med { color: var(--med); } .scn.low { color: var(--low); }
  .concept-tag { position: absolute; top: -8px; right: 6px; font-family: var(--mono); font-size: 10px; color: #5b6678; letter-spacing: .1em; }

  .scrollcue { align-self: center; font-family: var(--mono); font-size: 10px; letter-spacing: .2em; color: var(--dimmer); text-align: center; }
  .scrollcue .mouse { width: 18px; height: 28px; border: 1.5px solid #3a455c; border-radius: 10px; margin: 0 auto 7px; position: relative; display: block; }
  .scrollcue .mouse::after { content: ""; position: absolute; top: 5px; left: 50%; transform: translateX(-50%); width: 3px; height: 6px; border-radius: 2px; background: var(--accent); animation: wheel 1.6s ease-in-out infinite; }

  @media (max-width: 767px) {
    .hero { min-height: auto; }
    .fg { padding: 20px var(--pad) 30px; }
    .hero-grid { grid-template-columns: 1fr; gap: 26px; padding: 28px 0; }
    h1 { font-size: clamp(28px, 7.4vw, 34px); overflow-wrap: anywhere; }
    .sub { max-width: none; overflow-wrap: anywhere; }
    .sc1-meta { line-height: 1.5; }
    .scrollcue { margin-top: 8px; }
  }

  /* desktop/landscape only: frosted glass (mobile keeps the solid card for perf) */
  @media (min-width: 861px) {
    .scorecard { background: linear-gradient(180deg, rgba(17,23,38,.62), rgba(11,16,28,.7)); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  }
</style>
